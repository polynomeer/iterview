# Local Docker Compose overrides. Copy to .env only when you need non-default values.
# Never use these development values for a deployed environment.

POSTGRES_DB=iterview
POSTGRES_USER=iterview
POSTGRES_PASSWORD=iterview
AUTH_TOKEN_SECRET=dev-only-secret-change-me

# Host ports. Unset, ./scripts/dev_all.sh starts from 5432/8080/5173 and moves to the next free
# port when another process holds one. Set them to pin a port (a taken pinned port is an error).
# POSTGRES_PORT=5432
# API_PORT=8080
# WEB_PORT=5173
