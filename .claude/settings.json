{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew compileKotlin:*)",
      "Bash(./gradlew compileTestKotlin:*)",
      "Bash(npm run test:run:*)",
      "Bash(npm run build:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc:*)",
      "Bash(./scripts/test_all.sh:*)",
      "Bash(./scripts/build_all.sh:*)",
      "Bash(bash ./scripts/test_all.sh:*)",
      "Bash(bash ./scripts/build_all.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./.env.local)",
      "Read(./apps/web/.env)",
      "Read(./apps/web/.env.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
